<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="http://framedash1.local/MorningBoard" version="1.0.3" viewmodes="maximized">
    <access origin="*" subdomains="true"></access>
    <tizen:application id="FrameDash1.MorningBoard" package="FrameDash1" required_version="2.3"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="extensive"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/prelaunch.support" value="false"/>
    <name>Morning Board</name>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * 'self' data: blob:; script-src 'self' file: $WEBAPIS https: 'unsafe-inline'; style-src 'self' file: https: 'unsafe-inline'; img-src * data: blob:; font-src * data:; connect-src *; frame-src *</tizen:content-security-policy>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="internal" hwkey-event="enable"/>
</widget>
